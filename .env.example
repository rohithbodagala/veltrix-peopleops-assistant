# Copy to .env and fill in ONE provider key. docker compose reads .env automatically.
# Data locations (the container mounts ./data at /app/data and uses the same layout).
CORPUS_DIR=./data/corpus
MANIFEST_PATH=./data/manifest.json
DB_PATH=./data/veltrix.db

# Today's date as YYYY-MM-DD. Empty = system date.
APP_TODAY=

# LLM provider: auto | openai | gemini | fake
# auto picks the first provider whose key is set (openai, then gemini),
# or the offline stand-in (fake) when no key is set.
LLM_PROVIDER=auto
# Optional model override. Defaults: openai=gpt-4.1, gemini=gemini-2.5-flash
LLM_MODEL=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Local CPU embeddings (BAAI/bge-small-en-v1.5, baked into the image). off = BM25 only.
EMBEDDINGS=on
# Local runs only: where the embedding model is cached (the image sets /opt/models/fastembed).
FASTEMBED_CACHE_PATH=./models/fastembed

# Per LLM call timeout and overall per-request deadline (the API contract allows 30 s).
LLM_TIMEOUT_SECONDS=20
REQUEST_DEADLINE_SECONDS=27

LOG_LEVEL=INFO
# Optional log file path (JSON lines). Empty = stdout only.
LOG_FILE=
